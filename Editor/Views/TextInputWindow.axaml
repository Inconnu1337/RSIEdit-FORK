<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Editor.ViewModels"
        mc:Ignorable="d"
        x:Class="Editor.Views.TextInputWindow"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        Width="420"
        Height="180"
        CanResize="False"
        Icon="/Assets/logo.ico"
        Background="{DynamicResource AppBg}"
        x:DataType="vm:TextInputWindowViewModel">
    <Grid RowDefinitions="Auto, Auto, Auto"
          RowSpacing="12"
          Margin="24 20 24 20">
        <TextBlock Grid.Row="0"
                   Text="{Binding Header}"
                   FontWeight="SemiBold"
                   FontSize="13"
                   TextWrapping="Wrap"/>
        <TextBox Grid.Row="1"
                 Text="{Binding SubmittedText}"
                 TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="{DynamicResource loc-common-cancel}"
                    Command="{Binding Decline}"
                    IsCancel="True"
                    Width="80"
                    HorizontalContentAlignment="Center"/>
            <Button Classes="accent"
                    Content="{DynamicResource loc-common-accept}"
                    Command="{Binding Confirm}"
                    IsDefault="True"
                    Width="80"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
