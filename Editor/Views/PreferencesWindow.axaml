<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Editor.ViewModels"
        mc:Ignorable="d"
        x:Class="Editor.Views.PreferencesWindow"
        WindowStartupLocation="CenterOwner"
        Width="520"
        Height="520"
        CanResize="False"
        Title="{DynamicResource loc-prefs-title}"
        Icon="/Assets/logo.ico"
        Background="{DynamicResource AppBg}"
        x:DataType="vm:PreferencesWindowViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="28 22 28 20">

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{DynamicResource loc-prefs-title}"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0 0 0 18"/>

        <!-- Settings -->
        <StackPanel Grid.Row="1" Spacing="14">

            <!-- Section: Defaults -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource loc-prefs-section-defaults}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               LetterSpacing="1.5"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}"/>
                </StackPanel>
                <Grid ColumnDefinitions="130, *" RowDefinitions="Auto, Auto" RowSpacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource loc-prefs-default-license}"
                               Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DefaultLicense}"
                             Watermark="e.g. CC-BY-SA-3.0"/>
                    <TextBlock Classes="label" Text="{DynamicResource loc-prefs-default-copyright}"
                               Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultCopyright}"
                             Watermark="e.g. github.com/your-repo"/>
                </Grid>
            </StackPanel>

            <!-- Section: GitHub -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource loc-prefs-section-github}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               LetterSpacing="1.5"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}"/>
                </StackPanel>
                <Grid ColumnDefinitions="130, *" RowSpacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource loc-prefs-github-token}"
                               Grid.Column="0" VerticalAlignment="Center"
                               ToolTip.Tip="Used when fetching .dmi files from GitHub. Needed for private repos. Saved as plain text — repo scope only."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding GitHubToken}"
                                 PasswordChar="*"
                                 RevealPassword="{Binding RevealGitHubToken}"
                                 Width="260"
                                 Watermark="ghp_xxxxxxxxxxxx"/>
                        <CheckBox Content="{DynamicResource loc-prefs-show-token}"
                                  IsChecked="{Binding RevealGitHubToken}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Section: Language -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource loc-prefs-section-language}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               LetterSpacing="1.5"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}"/>
                </StackPanel>
                <Grid ColumnDefinitions="130, *" RowSpacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource loc-prefs-language}"
                               Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              SelectedIndex="{Binding SelectedLanguageIndex}"
                              HorizontalAlignment="Left"
                              MinWidth="200">
                        <ComboBoxItem Content="English (en-US)"/>
                        <ComboBoxItem Content="Русский (ru-RU)"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Section: Output -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource loc-prefs-section-output}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               LetterSpacing="1.5"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}"/>
                </StackPanel>
                <Grid ColumnDefinitions="130, *" RowDefinitions="Auto, Auto" RowSpacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource loc-prefs-minify-json}"
                               Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1"
                              IsChecked="{Binding MinifyJson}"
                              VerticalAlignment="Center"/>
                    <TextBlock Classes="label" Text="{DynamicResource loc-prefs-indentation}"
                               Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding Indentation}"
                                   Minimum="0" Maximum="8"
                                   Width="100"
                                   HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0 16 0 0">
            <Button Content="{DynamicResource loc-common-cancel}"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Command="{Binding Cancel}"
                    IsCancel="True"/>
            <Button Classes="accent"
                    Content="{DynamicResource loc-common-save}"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Command="{Binding Save}"
                    IsDefault="True"/>
        </StackPanel>

    </Grid>
</Window>
