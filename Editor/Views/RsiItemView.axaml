<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Editor.Views"
             xmlns:vm="clr-namespace:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.RsiItemView"
             x:DataType="vm:RsiItemViewModel">
    <DockPanel>

        <!-- Frame preview strip -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SectionBg}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0 0 0 1"
                Height="148">
            <views:RsiFramesView Name="Frames" DataContext="{Binding Frames}"/>
        </Border>

        <!-- Metadata bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SectionBg}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0 1 0 0"
                Padding="14 10">
            <Grid ColumnDefinitions="*, Auto">

                <StackPanel Grid.Column="0" Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="label" Width="76" Text="{DynamicResource loc-state-license}"/>
                        <TextBox Width="370" Text="{Binding License}"/>
                        <ComboBox SelectedItem="{Binding SelectedLicense}">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="CC-BY-SA-3.0" />
                            <ComboBoxItem Content="CC-BY-NC-SA-3.0" />
                            <ComboBoxItem Content="CC-BY-SA-4.0" />
                        </ComboBox>
                        <Button ToolTip.Tip="The license that these assets are under." Content="?"
                                Padding="6 4" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="label" Width="76" Text="{DynamicResource loc-state-copyright}"/>
                        <TextBox Width="370" Text="{Binding Copyright}"/>
                        <Button ToolTip.Tip="The copyright holder of these assets, typically a GitHub repository."
                                Content="?" Padding="6 4" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="7" Margin="24 0 0 0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="label" Text="{DynamicResource loc-state-size-x}"/>
                        <NumericUpDown ShowButtonSpinner="False" Value="{Binding SizeX}" Width="64"/>
                        <TextBlock Classes="label" Text="{DynamicResource loc-state-size-y}" Margin="6 0 0 0"/>
                        <NumericUpDown ShowButtonSpinner="False" Value="{Binding SizeY}" Width="64"/>
                        <TextBlock Classes="label" Text="{DynamicResource loc-state-search}" Margin="6 0 0 0"/>
                        <TextBox Text="{Binding Search, Mode=TwoWay}" Width="160"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="label" Text="{DynamicResource loc-state-folder}"/>
                        <TextBox IsReadOnly="True" Text="{Binding SaveFolder, Mode=TwoWay}" Width="320"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- State list -->
        <ScrollViewer>
            <ListBox Name="States"
                     SelectionMode="Multiple"
                     ItemsSource="{Binding VisibleStates}"
                     SelectedItems="{Binding SelectedStates}"
                     Background="Transparent"
                     Padding="8 8 8 0">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource loc-state-ctx-add}"          Command="{Binding CreateNewState}"/>
                        <MenuItem Header="{DynamicResource loc-state-ctx-import}"        IsEnabled="{Binding HasOneStateSelected}" Command="{Binding ImportImage}"/>
                        <MenuItem Header="{DynamicResource loc-state-ctx-export}"        IsEnabled="{Binding HasOneStateSelected}" Command="{Binding ExportPng}"/>
                        <MenuItem Header="{DynamicResource loc-state-ctx-delete}"        IsEnabled="{Binding HasStateSelected}"    Command="{Binding DeleteSelectedStates}"  InputGesture="Delete"/>
                        <MenuItem Header="{DynamicResource loc-state-ctx-delete-others}" IsEnabled="{Binding HasStateSelected}"    Command="{Binding DeleteUnselectedStates}" InputGesture="Ctrl+Delete"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RsiStateViewModel">
                        <views:RsiStateView DataContext="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </DockPanel>
</UserControl>
