<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.RsiFramesView"
             x:DataType="vm:RsiFramesViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12 8">

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowFull}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding Full}" />
                    </Border>
                    <TextBlock Text="Full" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowCardinals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding South}" />
                    </Border>
                    <TextBlock Text="South" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowCardinals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding North}" />
                    </Border>
                    <TextBlock Text="North" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowCardinals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding East}" />
                    </Border>
                    <TextBlock Text="East" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowCardinals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding West}" />
                    </Border>
                    <TextBlock Text="West" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowDiagonals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding SouthEast}" />
                    </Border>
                    <TextBlock Text="South East" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowDiagonals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding SouthWest}" />
                    </Border>
                    <TextBlock Text="South West" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowDiagonals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding NorthEast}" />
                    </Border>
                    <TextBlock Text="North East" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Padding="8 8 8 6"
                    IsVisible="{Binding ShowDiagonals}">
                <StackPanel Spacing="5">
                    <Border Width="96" Height="96" CornerRadius="4"
                            Background="{DynamicResource ImageAreaBg}" ClipToBounds="True">
                        <Image Source="{Binding NorthWest}" />
                    </Border>
                    <TextBlock Text="North West" Classes="label" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
