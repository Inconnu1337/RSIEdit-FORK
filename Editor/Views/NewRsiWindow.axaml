<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Editor.ViewModels"
        mc:Ignorable="d"
        x:Class="Editor.Views.ConfirmationWindow"
        Title="{DynamicResource loc-dialog-confirm-title}"
        WindowStartupLocation="CenterOwner"
        Width="380"
        Height="180"
        CanResize="False"
        Icon="/Assets/logo.ico"
        Background="{DynamicResource AppBg}"
        x:DataType="vm:ConfirmationWindowViewModel">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20"
                Margin="28">
        <TextBlock Text="{Binding Text}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="320"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
            <Button Command="{Binding Decline}"
                    IsCancel="True"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Content="{DynamicResource loc-common-no}"/>
            <Button Classes="accent"
                    Command="{Binding Confirm}"
                    IsDefault="True"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Content="{DynamicResource loc-common-yes}"/>
        </StackPanel>
    </StackPanel>
</Window>
