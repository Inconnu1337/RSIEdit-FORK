<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Editor.ViewModels"
        mc:Ignorable="d"
        x:Class="Editor.Views.TextReplaceWindow"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        Width="420"
        Height="220"
        CanResize="False"
        Icon="/Assets/logo.ico"
        Background="{DynamicResource AppBg}"
        x:DataType="vm:TextReplaceWindowViewModel">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
          RowSpacing="8"
          Margin="24 20 24 20">
        <TextBlock Grid.Row="0"
                   Classes="label"
                   Text="{DynamicResource loc-dialog-replace-replace}"/>
        <TextBox Grid.Row="1"
                 Text="{Binding Replace}"
                 TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2"
                   Classes="label"
                   Text="{DynamicResource loc-dialog-replace-with}"
                   Margin="0 4 0 0"/>
        <TextBox Grid.Row="3"
                 Text="{Binding With}"
                 TextWrapping="Wrap"/>
        <Button Grid.Row="4"
                Classes="accent"
                Command="{Binding Confirm}"
                IsDefault="True"
                HorizontalAlignment="Right"
                Padding="16 6"
                Content="{Binding Title}"
                Margin="0 8 0 0"/>
    </Grid>
</Window>
